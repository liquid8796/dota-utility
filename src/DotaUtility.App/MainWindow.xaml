<Window x:Class="DotaUtility.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:domain="clr-namespace:DotaUtility.Domain;assembly=DotaUtility.Domain"
        mc:Ignorable="d"
        Title="Dota Utility"
        Width="1100"
        Height="700"
        MinWidth="920"
        MinHeight="610"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#080B12"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="{StaticResource TextPrimaryBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            ResizeBorderThickness="7"
                            CornerRadius="14"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Storyboard x:Key="PulseStoryboard">
            <DoubleAnimation Storyboard.TargetName="PulseRing"
                             Storyboard.TargetProperty="Opacity"
                             From="0.52" To="0"
                             Duration="0:0:1.8"
                             RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.95" To="1.42"
                             Duration="0:0:1.8"
                             RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.95" To="1.42"
                             Duration="0:0:1.8"
                             RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="AmbientGlow"
                             Storyboard.TargetProperty="Opacity"
                             From="0.22" To="0.42"
                             Duration="0:0:3.2"
                             AutoReverse="True"
                             RepeatBehavior="Forever"/>
        </Storyboard>

        <Style x:Key="StatusColorBrushStyle" TargetType="Ellipse">
            <Setter Property="Stroke" Value="{StaticResource UnknownBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static domain:VisibilityState.Visible}">
                    <Setter Property="Stroke" Value="{StaticResource VisibleBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static domain:VisibilityState.Hidden}">
                    <Setter Property="Stroke" Value="{StaticResource HiddenBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusOrbStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="#238C96AF"/>
            <Setter Property="Stroke" Value="#8C96AF"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static domain:VisibilityState.Visible}">
                    <Setter Property="Fill" Value="#30FF5C78"/>
                    <Setter Property="Stroke" Value="{StaticResource VisibleBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static domain:VisibilityState.Hidden}">
                    <Setter Property="Fill" Value="#284FE3A4"/>
                    <Setter Property="Stroke" Value="{StaticResource HiddenBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource UnknownBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static domain:VisibilityState.Visible}">
                    <Setter Property="Foreground" Value="{StaticResource VisibleBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static domain:VisibilityState.Hidden}">
                    <Setter Property="Foreground" Value="{StaticResource HiddenBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConnectionDotStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="#FF7582A2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAttached}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource HiddenBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavTabRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabRoot"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="#387C5CFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource PulseStoryboard}"/>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.18,0.05" GradientOrigin="0.18,0.05" RadiusX="0.85" RadiusY="0.85">
                <GradientStop Color="#261C2B5C" Offset="0"/>
                <GradientStop Color="#120E1834" Offset="0.35"/>
                <GradientStop Color="#080B12" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <!-- Ambient color bloom -->
        <Ellipse x:Name="AmbientGlow"
                 Width="620" Height="620"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,-360,-230,0"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#8E6848FF" Offset="0"/>
                    <GradientStop Color="#006848FF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="80"/>
            </Ellipse.Effect>
        </Ellipse>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Grid Grid.Row="0" Margin="20,7,12,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="10" Background="#277C5CFF" BorderBrush="#507C5CFF" BorderThickness="1">
                        <Grid>
                            <Ellipse Width="12" Height="12" Stroke="#CBBEFF" StrokeThickness="2"/>
                            <Ellipse Width="4" Height="4" Fill="#E5DEFF"/>
                        </Grid>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="DOTA VISIBILITY" FontSize="12" FontWeight="SemiBold" Foreground="#E6E9F4"/>
                        <TextBlock Text="READ-ONLY SOURCE 2 MONITOR" FontSize="8" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Tabs (Dashboard / Settings) -->
                <Border Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#B0101420"
                        BorderBrush="#24FFFFFF"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="3"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Dashboard"
                                     GroupName="MainNavTabs"
                                     Style="{StaticResource NavTabRadioStyle}"
                                     IsChecked="{Binding IsDashboardTabSelected, Mode=TwoWay}"/>
                        <RadioButton Content="Settings"
                                     GroupName="MainNavTabs"
                                     Style="{StaticResource NavTabRadioStyle}"
                                     Margin="4,0,0,0"
                                     IsChecked="{Binding IsSettingsTabSelected, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButtonStyle}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize"/>
                    <Button Style="{StaticResource TitleBarButtonStyle}" Content="&#xE922;" Click="MaximizeRestore_Click" ToolTip="Maximize / Restore"/>
                    <Button Style="{StaticResource TitleBarButtonStyle}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close">
                        <Button.Resources>
                            <Style TargetType="Border"/>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="32,18,32,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Enemy vision, without the guesswork."
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Live local-hero visibility signal read directly from Dota 2's client state."
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,7,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            VerticalAlignment="Center"
                            Background="#A5101420"
                            BorderBrush="#2CFFFFFF"
                            BorderThickness="1"
                            CornerRadius="15"
                            Padding="13,8"
                            Margin="20,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Style="{StaticResource ConnectionDotStyle}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ConnectionText}" FontSize="10" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <Border Width="1" Height="12" Background="#28FFFFFF" Margin="10,0"/>
                            <TextBlock Text="{Binding ProcessText}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- TAB 1: Main dashboard -->
                <Grid Grid.Row="2" Visibility="{Binding IsDashboardTabSelected, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="0.85*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Primary vision card -->
                    <Border Grid.Column="0" CornerRadius="28" BorderThickness="1" Padding="30">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#C8141825"/>
                                <Setter Property="BorderBrush" Value="#2CFFFFFF"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static domain:VisibilityState.Visible}">
                                        <Setter Property="BorderBrush" Value="#55FF5C78"/>
                                        <Setter Property="Background" Value="#C9171723"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static domain:VisibilityState.Hidden}">
                                        <Setter Property="BorderBrush" Value="#454FE3A4"/>
                                        <Setter Property="Background" Value="#C9121A1C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="LOCAL HERO" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="Visibility signal" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#16FFFFFF" CornerRadius="10" Padding="10,6" VerticalAlignment="Top">
                                    <TextBlock Text="150 ms polling" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,12,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Width="205" Height="205" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse x:Name="PulseRing"
                                             Width="150" Height="150"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             StrokeThickness="1.5"
                                             RenderTransformOrigin="0.5,0.5"
                                             Style="{StaticResource StatusColorBrushStyle}">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse Width="142" Height="142" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource StatusOrbStyle}"/>
                                    <Ellipse Width="104" Height="104" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#0CFFFFFF" Stroke="#18FFFFFF" StrokeThickness="1"/>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Width="40" Height="24" StrokeThickness="2" Style="{StaticResource StatusColorBrushStyle}"/>
                                        <Ellipse Width="10" Height="10" Style="{StaticResource StatusOrbStyle}"/>
                                    </Grid>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding StatusEyebrow}" FontSize="10" FontWeight="SemiBold" Style="{StaticResource StatusTextStyle}"/>
                                    <TextBlock Text="{Binding StatusHeadline}"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"
                                               FontSize="48"
                                               FontWeight="SemiBold"
                                               Margin="0,2,0,0"
                                               Style="{StaticResource StatusTextStyle}"/>
                                    <TextBlock Text="{Binding StatusDetail}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               MaxWidth="300"
                                               Margin="0,9,0,0"
                                               LineHeight="19"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#0EFFFFFF" CornerRadius="14" Padding="14,11" Margin="0,0,7,0">
                                    <StackPanel>
                                        <TextBlock Text="YOUR TEAM" FontSize="8" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding LocalTeamText}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#0EFFFFFF" CornerRadius="14" Padding="14,11" Margin="7,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="ENEMY TEAM" FontSize="8" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding EnemyTeamText}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Diagnostics -->
                    <Border Grid.Column="2" Background="#B8111521" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="28" Padding="25">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="LIVE DIAGNOSTICS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="Source 2 telemetry" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
                            </StackPanel>

                            <Border Grid.Row="2" Style="{StaticResource MetricCardStyle}" Margin="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="TEAM VISIBILITY MASK" FontSize="8" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding VisibilityMaskText}" FontFamily="Cascadia Mono, Consolas" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="34" Height="34" Background="#197C5CFF" CornerRadius="10" VerticalAlignment="Center">
                                        <TextBlock Text="01" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#BFAEFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Row="4" Style="{StaticResource MetricCardStyle}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="LOCAL HERO POINTER" FontSize="8" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding HeroAddressText}" FontFamily="Cascadia Mono, Consolas" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="6" Style="{StaticResource MetricCardStyle}" Margin="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="LAST SAMPLE" FontSize="8" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding LastUpdatedText}" FontFamily="Cascadia Mono, Consolas" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <Ellipse Grid.Column="1" Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Enemy Hero Minimap Icons Checkbox -->
                            <Border Grid.Row="8" Background="#167C5CFF" BorderBrush="#387C5CFF" BorderThickness="1" CornerRadius="14" Padding="14,11">
                                <CheckBox IsChecked="{Binding ShowEnemyHeroesOnMinimap, Mode=TwoWay}"
                                          VerticalContentAlignment="Center"
                                          Cursor="Hand">
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="Show enemy hero icons on Minimap"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Display enemy hero icons everywhere on the Dota 2 minimap"
                                                   FontSize="10"
                                                   Foreground="#C7BEFF"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Grid.Row="10" Background="#0F4FE3A4" BorderBrush="#224FE3A4" BorderThickness="1" CornerRadius="14" Padding="13,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="24" Height="24" CornerRadius="8" Background="#224FE3A4">
                                        <TextBlock Text="✓" Foreground="{StaticResource HiddenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="READ-ONLY MEMORY ACCESS" FontSize="9" FontWeight="SemiBold" Foreground="#B9F3D9"/>
                                        <TextBlock Text="External ReadProcessMemory · no write or hook rights" FontSize="9" Foreground="#6EA992" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- TAB 2: Settings -->
                <Grid Grid.Row="2" Visibility="{Binding IsSettingsTabSelected, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="0.85*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Close & System Tray Settings Card -->
                    <Border Grid.Column="0" Background="#C8141825" BorderBrush="#2CFFFFFF" BorderThickness="1" CornerRadius="28" Padding="30">
                        <StackPanel>
                            <TextBlock Text="WINDOW &amp; SYSTEM TRAY" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="Close button behavior" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/>
                            <TextBlock Text="Configure what happens when you click the Close (X) button and whether to remember your choice."
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,6,0,18"
                                       TextWrapping="Wrap"/>

                            <!-- Option 1: Minimize to System Tray -->
                            <Border Background="#12FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="14" Padding="16,13">
                                <RadioButton GroupName="SettingsCloseBehavior"
                                             IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}"
                                             VerticalContentAlignment="Top"
                                             Cursor="Hand">
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="Minimize to System Tray" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Hide the window to the Windows System Tray and keep the Dota 2 particle ring active in the background."
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,3,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </RadioButton>
                            </Border>

                            <!-- Option 2: Exit Application -->
                            <Border Background="#12FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="14" Padding="16,13" Margin="0,10,0,0">
                                <RadioButton GroupName="SettingsCloseBehavior"
                                             IsChecked="{Binding ExitOnClose, Mode=TwoWay}"
                                             VerticalContentAlignment="Top"
                                             Cursor="Hand">
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="Exit Application" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Close Dota Utility completely and stop monitoring when clicking Close."
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,3,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </RadioButton>
                            </Border>

                            <!-- Remember choice checkbox -->
                            <Border Background="#167C5CFF" BorderBrush="#387C5CFF" BorderThickness="1" CornerRadius="14" Padding="16,13" Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding RememberCloseChoice, Mode=TwoWay}"
                                              VerticalContentAlignment="Center"
                                              Cursor="Hand">
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="Remember my choice (skip confirmation popup)"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding CloseBehaviorSummaryText}"
                                                       FontSize="11"
                                                       Foreground="#C7BEFF"
                                                       Margin="0,3,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </CheckBox>

                                    <Button Grid.Column="1"
                                            Content="Ask Every Time"
                                            Click="ResetCloseConfirmation_Click"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0"
                                            Padding="12,7"
                                            FontSize="11"
                                            Background="#1EFFFFFF"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            BorderBrush="#30FFFFFF"
                                            BorderThickness="1"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ResetBtnBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="9"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ResetBtnBorder" Property="Background" Value="#30FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Particle Indicator & Storage Details Card -->
                    <Border Grid.Column="2" Background="#B8111521" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="28" Padding="25">
                        <StackPanel>
                            <TextBlock Text="INDICATOR &amp; MINIMAP" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="In-Game Features" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,14"/>

                            <Border Background="#167C5CFF" BorderBrush="#387C5CFF" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,0,12">
                                <CheckBox IsChecked="{Binding ShowEnemyHeroesOnMinimap, Mode=TwoWay}"
                                          VerticalContentAlignment="Center"
                                          Cursor="Hand">
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="Show enemy hero icons everywhere on Minimap"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="Reveals enemy hero icons across the entire Dota 2 minimap (native VScript FoW viewer + external minimap overlay)."
                                                   FontSize="10.5"
                                                   Foreground="#C7BEFF"
                                                   Margin="0,3,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="RENDERING MODE" FontSize="8" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="range_display + true_sight_debuff" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource HiddenBrush}" Margin="0,4,0,0"/>
                                    <TextBlock Text="Feet range_display particle ring + overhead Sentry particle."
                                               FontSize="10.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="SETTINGS FILE" FontSize="8" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding SettingsPath}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="10.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,5,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource MetricCardStyle}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="SESSION LOG FILE" FontSize="8" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding LogPath}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="10.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,5,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Footer -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="DotaUtility" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text=" · " FontSize="10" Foreground="#30405A"/>
                        <TextBlock Text="{Binding VersionText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text=" · " FontSize="10" Foreground="#30405A"/>
                        <TextBlock Text="External Source 2 reader" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="LIVE / 6.7 Hz" FontFamily="Cascadia Mono, Consolas" FontSize="9" Foreground="#58637E"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
