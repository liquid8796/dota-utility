<Window x:Class="DotaUtility.App.VisionIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="340"
        Height="360"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <!--
        Static GPU-cached Dota 2 particle indicators:
        1) Overhead Sentry / True Sight particle (particles/items2_fx/true_sight_debuff.vpcf) above the hero's head.
        2) Ground range_display.vpcf particle circle around the hero's feet when visible.
        No Storyboard animations run on this layered window so WPF only uploads the bitmap when state changes.
    -->
    <Grid Background="Transparent"
          RenderOptions.BitmapScalingMode="LowQuality"
          RenderOptions.EdgeMode="Aliased">
        <Grid.CacheMode>
            <BitmapCache EnableClearType="False"
                         RenderAtScale="1"
                         SnapsToDevicePixels="True"/>
        </Grid.CacheMode>

        <!-- 1. Overhead Dota 2 Sentry / True Sight Particle (right above hero's head) -->
        <Grid x:Name="SentryIndicator"
              Width="96"
              Height="84"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,12,0,0"
              Visibility="Collapsed">
            <!-- Soft cyan-blue True Sight radial glow -->
            <Ellipse Width="88"
                     Height="72"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#6622D8FF" Offset="0.0"/>
                        <GradientStop Color="#2E149BFF" Offset="0.58"/>
                        <GradientStop Color="#000A64FF" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Outer True Sight particle ring -->
            <Ellipse Width="68"
                     Height="68"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Stroke="#B849E6FF"
                     StrokeThickness="1.6"
                     StrokeDashArray="4 3"
                     StrokeDashCap="Round"/>

            <!-- Upper & lower Sentry crest rays -->
            <Path Data="M 48,6 L 52,15 L 44,15 Z M 48,78 L 52,69 L 44,69 Z M 22,22 L 30,27 L 26,31 Z M 74,22 L 66,27 L 70,31 Z"
                  Fill="#D06BF0FF"/>

            <!-- Iconic Dota 2 Sentry / True Sight Eye silhouette -->
            <Path Data="M 14,42 C 26,24 70,24 82,42 C 70,60 26,60 14,42 Z"
                  Fill="#5009264A"
                  Stroke="#FF47ECFF"
                  StrokeThickness="2.6"
                  StrokeLineJoin="Round"/>

            <!-- Inner Sentry Eye iris -->
            <Ellipse Width="24"
                     Height="24"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Fill="#D81FC8FF"
                     Stroke="#FFB8FAFF"
                     StrokeThickness="2"/>

            <!-- Glowing True Sight pupil core -->
            <Ellipse Width="10"
                     Height="10"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Fill="#FFFFFFFF"/>
        </Grid>

        <!-- 2. Ground Dota 2 range_display.vpcf Particle Ring (around hero's feet) -->
        <Grid x:Name="Indicator"
              Width="316"
              Height="146"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="0,0,0,17">
            <!-- Soft inner range_display ground edge falloff -->
            <Ellipse Width="296"
                     Height="128"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Stroke="#3838E58B"
                     StrokeThickness="8">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#0038E58B" Offset="0.0"/>
                        <GradientStop Color="#0538E58B" Offset="0.72"/>
                        <GradientStop Color="#2446F29C" Offset="0.93"/>
                        <GradientStop Color="#0038E58B" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Crisp Dota 2 range_display.vpcf core ring -->
            <Ellipse Width="292"
                     Height="124"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Stroke="#E652FFAA"
                     StrokeThickness="2.2"/>

            <!-- Subtle particle sparkle segments along the ring perimeter -->
            <Ellipse Width="284"
                     Height="118"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Stroke="#88A8FFD4"
                     StrokeThickness="1.2"
                     StrokeDashArray="6 4 2 5"
                     StrokeDashCap="Round"/>
        </Grid>
    </Grid>
</Window>
